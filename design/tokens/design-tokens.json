{
  "$metadata": {
    "name": "Quick Study Web Design Tokens",
    "version": "1.0.0",
    "description": "Web 端设计令牌，供 AI 读取后修改 Vue 组件代码",
    "platform": "web",
    "framework": "Vue 3 + Tailwind CSS + Naive UI"
  },

  "colors": {
    "primary": {
      "50": "#EEF0FF",
      "100": "#DBDEFF",
      "200": "#B8BEFF",
      "300": "#9399FF",
      "400": "#6E75F5",
      "500": "#5B5FE9",
      "600": "#4A48D4",
      "700": "#3A35B8",
      "800": "#2D2895",
      "900": "#1F1E6B",
      "_comment": "500 为主色，用于按钮、链接、选中态"
    },
    "success": {
      "50": "#E8F9F0",
      "100": "#C5F0D8",
      "500": "#22B570",
      "600": "#1A965C",
      "700": "#0F7A48"
    },
    "error": {
      "50": "#FFEFEC",
      "100": "#FCD3CC",
      "500": "#F0503C",
      "600": "#D63A28",
      "700": "#B22A1A"
    },
    "warning": {
      "50": "#FFF8E6",
      "100": "#FFE9B8",
      "500": "#FFA42B",
      "600": "#E68A00",
      "700": "#B86D00"
    },
    "info": {
      "50": "#E8F1FF",
      "500": "#3B8BFF",
      "600": "#1E6FE0"
    },
    "neutral": {
      "0": "#FFFFFF",
      "50": "#FAFAFB",
      "100": "#F4F4F6",
      "200": "#E8E8EC",
      "300": "#D5D5DC",
      "400": "#B0B0BC",
      "500": "#8A8A96",
      "600": "#6B6B76",
      "700": "#525258",
      "800": "#3A3A3E",
      "900": "#242428",
      "950": "#161618"
    },
    "textSemantic": {
      "primary": "#242428",
      "secondary": "#6B6B76",
      "tertiary": "#8A8A96",
      "disabled": "#B0B0BC",
      "inverse": "#FFFFFF",
      "brand": "#5B5FE9",
      "success": "#1A965C",
      "error": "#D63A28"
    },
    "bgSemantic": {
      "page": "#F4F4F6",
      "card": "#FFFFFF",
      "subtle": "#FAFAFB",
      "hover": "#F4F4F6",
      "selected": "#EEF0FF"
    },
    "borderSemantic": {
      "default": "#E8E8EC",
      "strong": "#D5D5DC",
      "brand": "#5B5FE9"
    },
    "gradients": {
      "brand": "linear-gradient(135deg, #5B5FE9 0%, #7C4FD4 100%)",
      "brandSoft": "linear-gradient(135deg, #EEF0FF 0%, #F5F0FF 100%)"
    }
  },

  "typography": {
    "fontFamily": {
      "sans": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, 'Noto Sans SC', sans-serif",
      "mono": "'SF Mono', 'JetBrains Mono', 'Fira Code', Consolas, monospace"
    },
    "fontSize": {
      "xs": "12px",
      "sm": "13px",
      "base": "14px",
      "lg": "16px",
      "xl": "20px",
      "2xl": "24px",
      "3xl": "28px",
      "4xl": "34px"
    },
    "fontWeight": {
      "normal": "400",
      "medium": "500",
      "semibold": "600",
      "bold": "700"
    },
    "lineHeight": {
      "tight": "1.3",
      "normal": "1.5",
      "relaxed": "1.625"
    },
    "textStyles": {
      "display":    { "size": "34px", "weight": "700", "lineHeight": "1.2", "usage": "统计大数字" },
      "headline":   { "size": "24px", "weight": "700", "lineHeight": "1.25", "usage": "页面大标题" },
      "title1":     { "size": "20px", "weight": "600", "lineHeight": "1.3", "usage": "卡片标题" },
      "title2":     { "size": "16px", "weight": "600", "lineHeight": "1.35", "usage": "小标题" },
      "body":       { "size": "14px", "weight": "400", "lineHeight": "1.5", "usage": "正文默认" },
      "bodyMedium": { "size": "14px", "weight": "500", "lineHeight": "1.5", "usage": "强调正文" },
      "caption":    { "size": "13px", "weight": "400", "lineHeight": "1.4", "usage": "辅助文字" },
      "label":      { "size": "12px", "weight": "600", "lineHeight": "1.3", "usage": "标签、角标" }
    }
  },

  "spacing": {
    "0": "0",
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "20px",
    "6": "24px",
    "8": "32px",
    "10": "40px",
    "12": "48px",
    "16": "64px",
    "_comment": "所有间距必须是 4 的倍数"
  },

  "borderRadius": {
    "sm": "6px",
    "md": "8px",
    "lg": "12px",
    "xl": "16px",
    "2xl": "20px",
    "full": "9999px"
  },

  "shadows": {
    "none": "none",
    "xs": "0 1px 2px rgba(0, 0, 0, 0.04)",
    "sm": "0 1px 3px rgba(0, 0, 0, 0.06)",
    "md": "0 2px 8px rgba(0, 0, 0, 0.08)",
    "lg": "0 4px 16px rgba(0, 0, 0, 0.10)",
    "xl": "0 8px 32px rgba(0, 0, 0, 0.12)",
    "brand": "0 4px 12px rgba(91, 95, 233, 0.25)"
  },

  "transitions": {
    "fast": "150ms ease",
    "base": "200ms ease",
    "slow": "300ms ease"
  },

  "layout": {
    "sidebarWidth": "240px",
    "sidebarCollapsedWidth": "64px",
    "headerHeight": "64px",
    "contentMaxWidth": "1280px",
    "contentPadding": "24px"
  },

  "zIndex": {
    "base": "0",
    "dropdown": "1000",
    "sticky": "1100",
    "overlay": "1200",
    "modal": "1300",
    "toast": "1400"
  },

  "tailwindMapping": {
    "_comment": "Tailwind CSS 类名映射，AI 修改代码时直接使用这些类名",
    "colors": {
      "primary": "primary-50 ~ primary-900 (在 tailwind.config.js 中已定义)",
      "bg-page": "bg-neutral-100",
      "bg-card": "bg-white",
      "bg-subtle": "bg-neutral-50",
      "bg-selected": "bg-primary-50",
      "text-primary": "text-neutral-900",
      "text-secondary": "text-neutral-600",
      "text-tertiary": "text-neutral-500",
      "border-default": "border-neutral-200"
    },
    "spacing": "使用 Tailwind 内置 spacing (p-4=16px, p-6=24px, gap-4=16px 等)",
    "radius": "rounded-md(8px), rounded-lg(12px), rounded-xl(16px), rounded-full",
    "shadow": "shadow-sm, shadow-md, shadow-lg"
  }
}
